# Opcional: sem o .env, o Docker Compose e o backend usam os valores padrão
# (banco, usuário e senha "todolist"). Para trocar a senha ou as portas,
# copie este arquivo para .env (cp .env.example .env) e edite os valores.
# O .env real nunca vai para o Git.
#
# Atenção: o PostgreSQL só aplica a senha quando o volume do banco é criado.
# Se o banco já subiu antes com outra senha, recrie o volume com
# "docker compose down -v" (isso apaga as tarefas) antes de subir com a nova.

# Banco de dados
DB_HOST=localhost
DB_PORT=5432
DB_NAME=todolist
DB_USER=todolist
DB_PASSWORD=troque-esta-senha

# Portas publicadas pelo Docker Compose
BACKEND_PORT=8080
FRONTEND_PORT=4200

# Origens aceitas pelo CORS do backend (o ng serve roda em 4200)
CORS_ALLOWED_ORIGINS=http://localhost:4200
