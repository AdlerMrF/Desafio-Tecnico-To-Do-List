# Copie este arquivo para .env (cp .env.example .env) e troque a senha.
# O .env real nunca vai para o Git.

# Banco de dados
DB_HOST=localhost
DB_PORT=5432
DB_NAME=todolist
DB_USER=todolist
DB_PASSWORD=troque-esta-senha

# Portas publicadas pelo Docker Compose
BACKEND_PORT=8080
FRONTEND_PORT=4200

# Origens aceitas pelo CORS do backend (o ng serve roda em 4200)
CORS_ALLOWED_ORIGINS=http://localhost:4200
